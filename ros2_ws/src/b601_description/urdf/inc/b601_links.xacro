<?xml version="1.0"?>
<!--
  b601_links.xacro —— B601-DM 的“零件图”：每个 link 的质量/惯量/外形，每个 joint 的原点/轴/限位。

  数据来源：官方 rebotarm_ros2/src/rebotarm_bringup/description/DM/urdf/ReBot_Arm_DM.urdf
  - origin / axis / limit.lower / limit.upper / limit.effort / 惯量：原样照抄（真机物理事实，勿随手改）
  - 外形：用官方 collision STL 的包围盒换算成圆柱/盒子（尺寸见各 link 注释里的实测值）
  - limit.velocity：官方写 50 / 200（这是电机侧参数，不是 rad/s），这里改成可信的关节速度上限，
    否则 MoveIt 的时间参数化会退化成“瞬移”。真机联调时再按实测标定。

  链结构（base 为根）：
    world ─fixed─ base_link ─joint1─ link1 ─joint2─ link2 ─joint3─ link3
          ─joint4─ link4 ─joint5─ link5 ─joint6─ link6 ─fixed─ end_link
          ─prismatic─ finger_left_link / finger_right_link(跟随 finger_left)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- URDF effort uses the joint's units. The project stores motor-side torque in N·m. -->
  <xacro:macro name="b601_joint_limit" params="cfg name">
    <xacro:property name="joint" value="${cfg['joints'][name]}"/>
    <xacro:property name="driven" value="${cfg['joints'][cfg['robot']['gripper_joint']] if name == cfg['robot']['mimic_joint'] else joint}"/>
    <xacro:property name="effort" value="${joint['max_motor_torque_nm'] / driven['motor']['effort_scale'] if 'max_motor_torque_nm' in joint else joint['max_effort']}"/>
    <limit lower="${joint['min_pos']}" upper="${joint['max_pos']}"
           effort="${effort}" velocity="${joint['max_velocity']}"/>
  </xacro:macro>

  <xacro:macro name="b601_links" params="project_config_file">

    <!-- 唯一的限位来源：config/b601_project.yaml 的 joints 段。
         这里不再写任何数字 —— 想改限位只有那一个地方可改。 -->
    <xacro:property name="CFG" value="${xacro.load_yaml(project_config_file)}"/>
    <xacro:property name="G" value="${CFG['model']}"/>
    <xacro:b601_materials cfg="${CFG}"/>

    <!-- ============================================================ 基座 -->
    <!-- 世界系：给 RViz/MoveIt/仿真一个固定的参考根，避免 base_link 当根时
         台面安装位置无处可写。真机、MoveIt、MuJoCo 都从这里取变换。 -->
    <link name="world"/>

    <joint name="world_to_base" type="fixed">
      <origin xyz="${' '.join(map(str, G['joints']['world_to_base']['origin']['xyz']))}" rpy="${' '.join(map(str, G['joints']['world_to_base']['origin']['rpy']))}"/>
      <parent link="world"/>
      <child link="base_link"/>
    </joint>

    <!-- 底座：官方 collision 包围盒 0.140 × 0.200 × 0.088 m，质量 0.8366 kg -->
    <link name="base_link">
      <xacro:b601_inertial mass="${G['links']['base_link']['inertia']['mass']}"
        com="${' '.join(map(str, G['links']['base_link']['inertia']['com']))}"
        ixx="${G['links']['base_link']['inertia']['ixx']}" ixy="${G['links']['base_link']['inertia']['ixy']}" ixz="${G['links']['base_link']['inertia']['ixz']}"
        iyy="${G['links']['base_link']['inertia']['iyy']}" iyz="${G['links']['base_link']['inertia']['iyz']}" izz="${G['links']['base_link']['inertia']['izz']}"/>
      <visual name="base_link_visual">
        <xacro:b601_box_geom size="${' '.join(map(str, G['links']['base_link']['visual']['size']))}" xyz="${' '.join(map(str, G['links']['base_link']['visual']['xyz']))}" material="dark_grey"/>
      </visual>
      <collision name="base_link_collision">
        <xacro:b601_box_geom size="${' '.join(map(str, G['links']['base_link']['collision']['size']))}" xyz="${' '.join(map(str, G['links']['base_link']['collision']['xyz']))}" material="dark_grey"/>
      </collision>
    </link>

    <!-- ========================================================== 关节 1 -->
    <!-- 底座回转（绕 z，±2.8 rad）。电机 J4340P，额定力矩 27 N·m -->
    <link name="link1">
      <xacro:b601_inertial mass="${G['links']['link1']['inertia']['mass']}"
        com="${' '.join(map(str, G['links']['link1']['inertia']['com']))}"
        ixx="${G['links']['link1']['inertia']['ixx']}" ixy="${G['links']['link1']['inertia']['ixy']}" ixz="${G['links']['link1']['inertia']['ixz']}"
        iyy="${G['links']['link1']['inertia']['iyy']}" iyz="${G['links']['link1']['inertia']['iyz']}" izz="${G['links']['link1']['inertia']['izz']}"/>
      <visual name="link1_visual">
        <xacro:b601_cylinder_geom radius="${G['links']['link1']['visual']['radius']}" length="${G['links']['link1']['visual']['length']}" xyz="${' '.join(map(str, G['links']['link1']['visual']['xyz']))}" material="seeed_yellow"/>
      </visual>
      <collision name="link1_collision">
        <xacro:b601_cylinder_geom radius="${G['links']['link1']['collision']['radius']}" length="${G['links']['link1']['collision']['length']}" xyz="${' '.join(map(str, G['links']['link1']['collision']['xyz']))}" material="seeed_yellow"/>
      </collision>
    </link>

    <joint name="joint1" type="revolute">
      <origin xyz="${' '.join(map(str, G['joints']['joint1']['origin']['xyz']))}" rpy="${' '.join(map(str, G['joints']['joint1']['origin']['rpy']))}"/>
      <parent link="base_link"/>
      <child link="link1"/>
      <axis xyz="${' '.join(map(str, G['joints']['joint1']['axis']['xyz']))}"/>
      <!-- 限位按 2026-11-20 实测收紧：真机底座实际只能到 ±2.60 rad（手推到碰停测得
           −2.597 / +2.627），官方 URDF 的 ±2.8 越过了机械停止位。 -->
      <xacro:b601_joint_limit cfg="${CFG}" name="joint1"/>
    </joint>

    <!-- ========================================================== 关节 2 -->
    <!-- 大臂抬起（轴 -z，范围 [-3.14, 0]：0 为竖直向上，负值为向前倾） -->
    <link name="link2">
      <xacro:b601_inertial mass="${G['links']['link2']['inertia']['mass']}"
        com="${' '.join(map(str, G['links']['link2']['inertia']['com']))}"
        ixx="${G['links']['link2']['inertia']['ixx']}" ixy="${G['links']['link2']['inertia']['ixy']}" ixz="${G['links']['link2']['inertia']['ixz']}"
        iyy="${G['links']['link2']['inertia']['iyy']}" iyz="${G['links']['link2']['inertia']['iyz']}" izz="${G['links']['link2']['inertia']['izz']}"/>
      <!-- 实测包围盒 0.321 × 0.057 × 0.067，沿 -x 伸展的薄臂 -->
      <visual name="link2_visual">
        <xacro:b601_cylinder_geom radius="${G['links']['link2']['visual']['radius']}" length="${G['links']['link2']['visual']['length']}" xyz="${' '.join(map(str, G['links']['link2']['visual']['xyz']))}"
          rpy="${' '.join(map(str, G['links']['link2']['visual']['rpy']))}" material="seeed_yellow"/>
      </visual>
      <collision name="link2_collision">
        <xacro:b601_cylinder_geom radius="${G['links']['link2']['collision']['radius']}" length="${G['links']['link2']['collision']['length']}" xyz="${' '.join(map(str, G['links']['link2']['collision']['xyz']))}"
          rpy="${' '.join(map(str, G['links']['link2']['collision']['rpy']))}" material="seeed_yellow"/>
      </collision>
    </link>

    <joint name="joint2" type="revolute">
      <origin xyz="${' '.join(map(str, G['joints']['joint2']['origin']['xyz']))}" rpy="${' '.join(map(str, G['joints']['joint2']['origin']['rpy']))}"/>
      <parent link="link1"/>
      <child link="link2"/>
      <axis xyz="${' '.join(map(str, G['joints']['joint2']['axis']['xyz']))}"/>
      <xacro:b601_joint_limit cfg="${CFG}" name="joint2"/>
    </joint>

    <!-- ========================================================== 关节 3 -->
    <!-- 小臂（肘，轴 z，范围 [-3.14, 0]） -->
    <link name="link3">
      <xacro:b601_inertial mass="${G['links']['link3']['inertia']['mass']}"
        com="${' '.join(map(str, G['links']['link3']['inertia']['com']))}"
        ixx="${G['links']['link3']['inertia']['ixx']}" ixy="${G['links']['link3']['inertia']['ixy']}" ixz="${G['links']['link3']['inertia']['ixz']}"
        iyy="${G['links']['link3']['inertia']['iyy']}" iyz="${G['links']['link3']['inertia']['iyz']}" izz="${G['links']['link3']['inertia']['izz']}"/>
      <visual name="link3_visual">
        <xacro:b601_cylinder_geom radius="${G['links']['link3']['visual']['radius']}" length="${G['links']['link3']['visual']['length']}" xyz="${' '.join(map(str, G['links']['link3']['visual']['xyz']))}"
          rpy="${' '.join(map(str, G['links']['link3']['visual']['rpy']))}" material="seeed_yellow"/>
      </visual>
      <collision name="link3_collision">
        <xacro:b601_cylinder_geom radius="${G['links']['link3']['collision']['radius']}" length="${G['links']['link3']['collision']['length']}" xyz="${' '.join(map(str, G['links']['link3']['collision']['xyz']))}"
          rpy="${' '.join(map(str, G['links']['link3']['collision']['rpy']))}" material="seeed_yellow"/>
      </collision>
    </link>

    <joint name="joint3" type="revolute">
      <origin xyz="${' '.join(map(str, G['joints']['joint3']['origin']['xyz']))}" rpy="${' '.join(map(str, G['joints']['joint3']['origin']['rpy']))}"/>
      <parent link="link2"/>
      <child link="link3"/>
      <axis xyz="${' '.join(map(str, G['joints']['joint3']['axis']['xyz']))}"/>
      <xacro:b601_joint_limit cfg="${CFG}" name="joint3"/>
    </joint>

    <!-- ========================================================== 关节 4 -->
    <!-- 腕部回转（电机 J4310，7 N·m，范围 [-1.87, 1.57]） -->
    <link name="link4">
      <xacro:b601_inertial mass="${G['links']['link4']['inertia']['mass']}"
        com="${' '.join(map(str, G['links']['link4']['inertia']['com']))}"
        ixx="${G['links']['link4']['inertia']['ixx']}" ixy="${G['links']['link4']['inertia']['ixy']}" ixz="${G['links']['link4']['inertia']['ixz']}"
        iyy="${G['links']['link4']['inertia']['iyy']}" iyz="${G['links']['link4']['inertia']['iyz']}" izz="${G['links']['link4']['inertia']['izz']}"/>
      <!-- 腕部回转段。半径刻意收细到 0.026：真实 link4 的网格在这个区域更瘦，
           用大半径圆柱会把 link6 的腕部包进去，导致 MoveIt 在起始位形就报自碰撞。 -->
      <visual name="link4_visual">
        <xacro:b601_cylinder_geom radius="${G['links']['link4']['visual']['radius']}" length="${G['links']['link4']['visual']['length']}" xyz="${' '.join(map(str, G['links']['link4']['visual']['xyz']))}"
          rpy="${' '.join(map(str, G['links']['link4']['visual']['rpy']))}" material="silver"/>
      </visual>
      <collision name="link4_collision">
        <xacro:b601_cylinder_geom radius="${G['links']['link4']['collision']['radius']}" length="${G['links']['link4']['collision']['length']}" xyz="${' '.join(map(str, G['links']['link4']['collision']['xyz']))}"
          rpy="${' '.join(map(str, G['links']['link4']['collision']['rpy']))}" material="silver"/>
      </collision>
    </link>

    <joint name="joint4" type="revolute">
      <origin xyz="${' '.join(map(str, G['joints']['joint4']['origin']['xyz']))}" rpy="${' '.join(map(str, G['joints']['joint4']['origin']['rpy']))}"/>
      <parent link="link3"/>
      <child link="link4"/>
      <axis xyz="${' '.join(map(str, G['joints']['joint4']['axis']['xyz']))}"/>
      <xacro:b601_joint_limit cfg="${CFG}" name="joint4"/>
    </joint>

    <!-- ========================================================== 关节 5 -->
    <!-- 腕部俯仰（轴 z，范围 ±1.57） -->
    <link name="link5">
      <xacro:b601_inertial mass="${G['links']['link5']['inertia']['mass']}"
        com="${' '.join(map(str, G['links']['link5']['inertia']['com']))}"
        ixx="${G['links']['link5']['inertia']['ixx']}" ixy="${G['links']['link5']['inertia']['ixy']}" ixz="${G['links']['link5']['inertia']['ixz']}"
        iyy="${G['links']['link5']['inertia']['iyy']}" iyz="${G['links']['link5']['inertia']['iyz']}" izz="${G['links']['link5']['inertia']['izz']}"/>
      <visual name="link5_visual">
        <xacro:b601_cylinder_geom radius="${G['links']['link5']['visual']['radius']}" length="${G['links']['link5']['visual']['length']}" xyz="${' '.join(map(str, G['links']['link5']['visual']['xyz']))}" material="silver"/>
      </visual>
      <collision name="link5_collision">
        <xacro:b601_cylinder_geom radius="${G['links']['link5']['collision']['radius']}" length="${G['links']['link5']['collision']['length']}" xyz="${' '.join(map(str, G['links']['link5']['collision']['xyz']))}" material="silver"/>
      </collision>
    </link>

    <joint name="joint5" type="revolute">
      <origin xyz="${' '.join(map(str, G['joints']['joint5']['origin']['xyz']))}" rpy="${' '.join(map(str, G['joints']['joint5']['origin']['rpy']))}"/>
      <parent link="link4"/>
      <child link="link5"/>
      <axis xyz="${' '.join(map(str, G['joints']['joint5']['axis']['xyz']))}"/>
      <xacro:b601_joint_limit cfg="${CFG}" name="joint5"/>
    </joint>

    <!-- ========================================================== 关节 6 -->
    <!-- 末端自转（轴 z，±3.14） -->
    <link name="link6">
      <xacro:b601_inertial mass="${G['links']['link6']['inertia']['mass']}"
        com="${' '.join(map(str, G['links']['link6']['inertia']['com']))}"
        ixx="${G['links']['link6']['inertia']['ixx']}" ixy="${G['links']['link6']['inertia']['ixy']}" ixz="${G['links']['link6']['inertia']['ixz']}"
        iyy="${G['links']['link6']['inertia']['iyy']}" iyz="${G['links']['link6']['inertia']['iyz']}" izz="${G['links']['link6']['inertia']['izz']}"/>
      <visual name="link6_visual">
        <xacro:b601_cylinder_geom radius="${G['links']['link6']['visual']['radius']}" length="${G['links']['link6']['visual']['length']}" xyz="${' '.join(map(str, G['links']['link6']['visual']['xyz']))}" material="matte_black"/>
      </visual>
      <collision name="link6_collision">
        <xacro:b601_cylinder_geom radius="${G['links']['link6']['collision']['radius']}" length="${G['links']['link6']['collision']['length']}" xyz="${' '.join(map(str, G['links']['link6']['collision']['xyz']))}" material="matte_black"/>
      </collision>
    </link>

    <joint name="joint6" type="revolute">
      <origin xyz="${' '.join(map(str, G['joints']['joint6']['origin']['xyz']))}" rpy="${' '.join(map(str, G['joints']['joint6']['origin']['rpy']))}"/>
      <parent link="link5"/>
      <child link="link6"/>
      <axis xyz="${' '.join(map(str, G['joints']['joint6']['axis']['xyz']))}"/>
      <xacro:b601_joint_limit cfg="${CFG}" name="joint6"/>
    </joint>

    <!-- =========================================================== 夹爪 -->
    <!-- end_link = 夹爪基座，也就是 MoveIt 的 tip link。x 轴指向爪尖外侧 -->
    <link name="end_link">
      <xacro:b601_inertial mass="${G['links']['end_link']['inertia']['mass']}"
        com="${' '.join(map(str, G['links']['end_link']['inertia']['com']))}"
        ixx="${G['links']['end_link']['inertia']['ixx']}" ixy="${G['links']['end_link']['inertia']['ixy']}" ixz="${G['links']['end_link']['inertia']['ixz']}"
        iyy="${G['links']['end_link']['inertia']['iyy']}" iyz="${G['links']['end_link']['inertia']['iyz']}" izz="${G['links']['end_link']['inertia']['izz']}"/>
      <visual name="end_link_visual">
        <xacro:b601_box_geom size="${' '.join(map(str, G['links']['end_link']['visual']['size']))}" xyz="${' '.join(map(str, G['links']['end_link']['visual']['xyz']))}" material="accent_blue"/>
      </visual>
      <collision name="end_link_collision">
        <xacro:b601_box_geom size="${' '.join(map(str, G['links']['end_link']['collision']['size']))}" xyz="${' '.join(map(str, G['links']['end_link']['collision']['xyz']))}" material="accent_blue"/>
      </collision>
    </link>

    <joint name="end_joint" type="fixed">
      <origin xyz="${' '.join(map(str, G['joints']['end_joint']['origin']['xyz']))}" rpy="${' '.join(map(str, G['joints']['end_joint']['origin']['rpy']))}"/>
      <parent link="link6"/>
      <child link="end_link"/>
      <axis xyz="${' '.join(map(str, G['joints']['end_joint']['axis']['xyz']))}"/>
    </joint>

    <!-- 左指：主动关节，沿 +y 移动 0 → 0.05 m -->
    <link name="finger_left_link">
      <xacro:b601_inertial mass="${G['links']['finger_left_link']['inertia']['mass']}"
        com="${' '.join(map(str, G['links']['finger_left_link']['inertia']['com']))}"
        ixx="${G['links']['finger_left_link']['inertia']['ixx']}" ixy="${G['links']['finger_left_link']['inertia']['ixy']}" ixz="${G['links']['finger_left_link']['inertia']['ixz']}"
        iyy="${G['links']['finger_left_link']['inertia']['iyy']}" iyz="${G['links']['finger_left_link']['inertia']['iyz']}" izz="${G['links']['finger_left_link']['inertia']['izz']}"/>
      <visual name="finger_left_visual">
        <xacro:b601_box_geom size="${' '.join(map(str, G['links']['finger_left_link']['visual']['size']))}" xyz="${' '.join(map(str, G['links']['finger_left_link']['visual']['xyz']))}" material="matte_black"/>
      </visual>
      <collision name="finger_left_collision">
        <xacro:b601_box_geom size="${' '.join(map(str, G['links']['finger_left_link']['collision']['size']))}" xyz="${' '.join(map(str, G['links']['finger_left_link']['collision']['xyz']))}" material="matte_black"/>
      </collision>
    </link>

    <joint name="finger_left" type="prismatic">
      <origin xyz="${' '.join(map(str, G['joints']['finger_left']['origin']['xyz']))}" rpy="${' '.join(map(str, G['joints']['finger_left']['origin']['rpy']))}"/>
      <parent link="end_link"/>
      <child link="finger_left_link"/>
      <axis xyz="${' '.join(map(str, G['joints']['finger_left']['axis']['xyz']))}"/>
      <xacro:b601_joint_limit cfg="${CFG}" name="finger_left"/>
    </joint>

    <!-- 右指：从动关节（mimic），位移与左指严格相反 → 平行夹爪 -->
    <link name="finger_right_link">
      <xacro:b601_inertial mass="${G['links']['finger_right_link']['inertia']['mass']}"
        com="${' '.join(map(str, G['links']['finger_right_link']['inertia']['com']))}"
        ixx="${G['links']['finger_right_link']['inertia']['ixx']}" ixy="${G['links']['finger_right_link']['inertia']['ixy']}" ixz="${G['links']['finger_right_link']['inertia']['ixz']}"
        iyy="${G['links']['finger_right_link']['inertia']['iyy']}" iyz="${G['links']['finger_right_link']['inertia']['iyz']}" izz="${G['links']['finger_right_link']['inertia']['izz']}"/>
      <visual name="finger_right_visual">
        <xacro:b601_box_geom size="${' '.join(map(str, G['links']['finger_right_link']['visual']['size']))}" xyz="${' '.join(map(str, G['links']['finger_right_link']['visual']['xyz']))}" material="matte_black"/>
      </visual>
      <collision name="finger_right_collision">
        <xacro:b601_box_geom size="${' '.join(map(str, G['links']['finger_right_link']['collision']['size']))}" xyz="${' '.join(map(str, G['links']['finger_right_link']['collision']['xyz']))}" material="matte_black"/>
      </collision>
    </link>

    <joint name="finger_right" type="prismatic">
      <origin xyz="${' '.join(map(str, G['joints']['finger_right']['origin']['xyz']))}" rpy="${' '.join(map(str, G['joints']['finger_right']['origin']['rpy']))}"/>
      <parent link="end_link"/>
      <child link="finger_right_link"/>
      <axis xyz="${' '.join(map(str, G['joints']['finger_right']['axis']['xyz']))}"/>
      <xacro:b601_joint_limit cfg="${CFG}" name="finger_right"/>
      <!-- 左指移动 dy，右指移动 -dy；这是“一个驱动器两个手指”的建模方式 -->
      <xacro:property name="M" value="${G['joints']['finger_right']['mimic']}"/>
      <mimic joint="${M['joint']}" multiplier="${M['multiplier']}" offset="${M['offset']}"/>
    </joint>

  </xacro:macro>
</robot>
