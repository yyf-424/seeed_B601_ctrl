<?xml version="1.0"?>
<!--
  b601_links.xacro —— B601-DM 的“零件图”：每个 link 的质量/惯量/外形，每个 joint 的原点/轴/限位。

  数据来源：官方 rebotarm_ros2/src/rebotarm_bringup/description/DM/urdf/ReBot_Arm_DM.urdf
  - origin / axis / limit.lower / limit.upper / limit.effort / 惯量：原样照抄（真机物理事实，勿随手改）
  - 外形：用官方 collision STL 的包围盒换算成圆柱/盒子（尺寸见各 link 注释里的实测值）
  - limit.velocity：官方写 50 / 200（这是电机侧参数，不是 rad/s），这里改成可信的关节速度上限，
    否则 MoveIt 的时间参数化会退化成“瞬移”。真机联调时再按实测标定。

  链结构（base 为根）：
    world ─fixed─ base_link ─joint1─ link1 ─joint2─ link2 ─joint3─ link3
          ─joint4─ link4 ─joint5─ link5 ─joint6─ link6 ─fixed─ end_link
          ─prismatic─ finger_left_link / finger_right_link(跟随 finger_left)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="b601_links" params="project_config_file">

    <!-- 唯一的限位来源：config/b601_project.yaml 的 joints 段。
         这里不再写任何数字 —— 想改限位只有那一个地方可改。 -->
    <xacro:property name="CFG" value="${xacro.load_yaml(project_config_file)}"/>
    <xacro:property name="J" value="${CFG['joints']}"/>

    <!-- ============================================================ 基座 -->
    <!-- 世界系：给 RViz/MoveIt/仿真一个固定的参考根，避免 base_link 当根时
         台面安装位置无处可写。真机、MoveIt、MuJoCo 都从这里取变换。 -->
    <link name="world"/>

    <joint name="world_to_base" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="world"/>
      <child link="base_link"/>
    </joint>

    <!-- 底座：官方 collision 包围盒 0.140 × 0.200 × 0.088 m，质量 0.8366 kg -->
    <link name="base_link">
      <xacro:b601_inertial mass="0.83660000"
        com="-7.849E-06 -1.1531E-06 0.029841"
        ixx="0.00133040" ixy="0.00000001" ixz="0.00000000"
        iyy="0.00213119" iyz="0.00000000" izz="0.00275877"/>
      <visual name="base_link_visual">
        <xacro:b601_box_geom size="0.140 0.200 0.088" xyz="0 0 0.0439" material="dark_grey"/>
      </visual>
      <collision name="base_link_collision">
        <xacro:b601_box_geom size="0.140 0.200 0.088" xyz="0 0 0.0439" material="dark_grey"/>
      </collision>
    </link>

    <!-- ========================================================== 关节 1 -->
    <!-- 底座回转（绕 z，±2.8 rad）。电机 J4340P，额定力矩 27 N·m -->
    <link name="link1">
      <xacro:b601_inertial mass="0.16130000"
        com="0.000113614552951627 -0.000616319527051323 0.0236476372671394"
        ixx="0.00025207" ixy="0.00000000" ixz="-0.00002832"
        iyy="0.00015464" iyz="0.00000000" izz="0.00023416"/>
      <visual name="link1_visual">
        <xacro:b601_cylinder_geom radius="0.042" length="0.084" xyz="0.0067 0 0.042" material="seeed_yellow"/>
      </visual>
      <collision name="link1_collision">
        <xacro:b601_cylinder_geom radius="0.042" length="0.084" xyz="0.0067 0 0.042" material="seeed_yellow"/>
      </collision>
    </link>

    <joint name="joint1" type="revolute">
      <origin xyz="-8.416E-05 0 0.08465" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="link1"/>
      <axis xyz="0 0 1"/>
      <!-- 限位按 2026-11-20 实测收紧：真机底座实际只能到 ±2.60 rad（手推到碰停测得
           −2.597 / +2.627），官方 URDF 的 ±2.8 越过了机械停止位。 -->
      <limit lower="${J['joint1']['min_pos']}" upper="${J['joint1']['max_pos']}"
             effort="${J['joint1']['max_effort']}" velocity="${J['joint1']['max_velocity']}"/>
    </joint>

    <!-- ========================================================== 关节 2 -->
    <!-- 大臂抬起（轴 -z，范围 [-3.14, 0]：0 为竖直向上，负值为向前倾） -->
    <link name="link2">
      <xacro:b601_inertial mass="1.32660000"
        com="-0.13225622308888 -0.0030617036386309 -0.0308306967030205"
        ixx="0.00073374" ixy="-0.00000043" ixz="0.00000851"
        iyy="0.01255987" iyz="0.00000128" izz="0.01281387"/>
      <!-- 实测包围盒 0.321 × 0.057 × 0.067，沿 -x 伸展的薄臂 -->
      <visual name="link2_visual">
        <xacro:b601_cylinder_geom radius="0.030" length="0.321" xyz="-0.132 0 -0.0316"
          rpy="0 ${pi/2} 0" material="seeed_yellow"/>
      </visual>
      <collision name="link2_collision">
        <xacro:b601_cylinder_geom radius="0.030" length="0.321" xyz="-0.132 0 -0.0316"
          rpy="0 ${pi/2} 0" material="seeed_yellow"/>
      </collision>
    </link>

    <joint name="joint2" type="revolute">
      <origin xyz="0.020084 0.031625 0.05555" rpy="-1.5708 0 0"/>
      <parent link="link1"/>
      <child link="link2"/>
      <axis xyz="0 0 -1"/>
      <limit lower="${J['joint2']['min_pos']}" upper="${J['joint2']['max_pos']}"
             effort="${J['joint2']['max_effort']}" velocity="${J['joint2']['max_velocity']}"/>
    </joint>

    <!-- ========================================================== 关节 3 -->
    <!-- 小臂（肘，轴 z，范围 [-3.14, 0]） -->
    <link name="link3">
      <xacro:b601_inertial mass="0.83530000"
        com="0.121040035791843 -0.0536211076627949 -0.0310137854608077"
        ixx="0.00046807" ixy="-0.00003456" ixz="-0.00004260"
        iyy="0.00632695" iyz="0.00000006" izz="0.00648221"/>
      <visual name="link3_visual">
        <xacro:b601_cylinder_geom radius="0.032" length="0.298" xyz="0.122 -0.030 -0.031"
          rpy="0 ${pi/2} 0" material="seeed_yellow"/>
      </visual>
      <collision name="link3_collision">
        <xacro:b601_cylinder_geom radius="0.032" length="0.298" xyz="0.122 -0.030 -0.031"
          rpy="0 ${pi/2} 0" material="seeed_yellow"/>
      </collision>
    </link>

    <joint name="joint3" type="revolute">
      <origin xyz="-0.264 0 0" rpy="0 0 0"/>
      <parent link="link2"/>
      <child link="link3"/>
      <axis xyz="0 0 1"/>
      <limit lower="${J['joint3']['min_pos']}" upper="${J['joint3']['max_pos']}"
             effort="${J['joint3']['max_effort']}" velocity="${J['joint3']['max_velocity']}"/>
    </joint>

    <!-- ========================================================== 关节 4 -->
    <!-- 腕部回转（电机 J4310，7 N·m，范围 [-1.87, 1.57]） -->
    <link name="link4">
      <xacro:b601_inertial mass="0.52000000"
        com="0.0608200956293136 -0.0511711906613122 -0.030299458623927"
        ixx="0.00045986" ixy="0.00024219" ixz="-0.00000672"
        iyy="0.00075258" iyz="-0.00000535" izz="0.00066742"/>
      <!-- 腕部回转段。半径刻意收细到 0.026：真实 link4 的网格在这个区域更瘦，
           用大半径圆柱会把 link6 的腕部包进去，导致 MoveIt 在起始位形就报自碰撞。 -->
      <visual name="link4_visual">
        <xacro:b601_cylinder_geom radius="0.026" length="0.125" xyz="0.048 -0.030 -0.030"
          rpy="0 ${pi/2} 0" material="silver"/>
      </visual>
      <collision name="link4_collision">
        <xacro:b601_cylinder_geom radius="0.026" length="0.125" xyz="0.048 -0.030 -0.030"
          rpy="0 ${pi/2} 0" material="silver"/>
      </collision>
    </link>

    <joint name="joint4" type="revolute">
      <origin xyz="0.2426 -0.054 -0.001625" rpy="0 0 0"/>
      <parent link="link3"/>
      <child link="link4"/>
      <axis xyz="0 0 1"/>
      <limit lower="${J['joint4']['min_pos']}" upper="${J['joint4']['max_pos']}"
             effort="${J['joint4']['max_effort']}" velocity="${J['joint4']['max_velocity']}"/>
    </joint>

    <!-- ========================================================== 关节 5 -->
    <!-- 腕部俯仰（轴 z，范围 ±1.57） -->
    <link name="link5">
      <xacro:b601_inertial mass="0.38300000"
        com="-0.00502802058982517 1.73866206692364E-06 0.0386233236326755"
        ixx="0.00019772" ixy="-0.00000062" ixz="-0.00002426"
        iyy="0.00021737" iyz="0.00000002" izz="0.00017191"/>
      <visual name="link5_visual">
        <xacro:b601_cylinder_geom radius="0.038" length="0.085" xyz="-0.003 0 0.0355" material="silver"/>
      </visual>
      <collision name="link5_collision">
        <xacro:b601_cylinder_geom radius="0.038" length="0.085" xyz="-0.003 0 0.0355" material="silver"/>
      </collision>
    </link>

    <joint name="joint5" type="revolute">
      <origin xyz="0.078308 -0.0375 -0.03" rpy="-1.5708 0 0"/>
      <parent link="link4"/>
      <child link="link5"/>
      <axis xyz="0 0 1"/>
      <limit lower="${J['joint5']['min_pos']}" upper="${J['joint5']['max_pos']}"
             effort="${J['joint5']['max_effort']}" velocity="${J['joint5']['max_velocity']}"/>
    </joint>

    <!-- ========================================================== 关节 6 -->
    <!-- 末端自转（轴 z，±3.14） -->
    <link name="link6">
      <xacro:b601_inertial mass="0.36630000"
        com="3.76418727127126E-06 -0.000100908819946677 0.0253308606425965"
        ixx="0.00015554" ixy="-0.00000" ixz="-0.00000"
        iyy="0.00015554" iyz="-0.0000" izz="0.00013966"/>
      <visual name="link6_visual">
        <xacro:b601_cylinder_geom radius="0.034" length="0.058" xyz="0 0 0.024" material="matte_black"/>
      </visual>
      <collision name="link6_collision">
        <xacro:b601_cylinder_geom radius="0.034" length="0.058" xyz="0 0 0.024" material="matte_black"/>
      </collision>
    </link>

    <joint name="joint6" type="revolute">
      <origin xyz="0.028008 0 0.04" rpy="0 1.5708 0"/>
      <parent link="link5"/>
      <child link="link6"/>
      <axis xyz="0 0 1"/>
      <limit lower="${J['joint6']['min_pos']}" upper="${J['joint6']['max_pos']}"
             effort="${J['joint6']['max_effort']}" velocity="${J['joint6']['max_velocity']}"/>
    </joint>

    <!-- =========================================================== 夹爪 -->
    <!-- end_link = 夹爪基座，也就是 MoveIt 的 tip link。x 轴指向爪尖外侧 -->
    <link name="end_link">
      <xacro:b601_inertial mass="0.5000000"
        com="-0.0737654295815033 -9.5080995865868E-06 7.04327840286845E-06"
        ixx="0.00037354" ixy="-0.00000011" ixz="0.00000050"
        iyy="0.00015830" iyz="0.00000348" izz="0.00045353"/>
      <visual name="end_link_visual">
        <xacro:b601_box_geom size="0.034 0.184 0.069" xyz="-0.090 0 0" material="accent_blue"/>
      </visual>
      <collision name="end_link_collision">
        <xacro:b601_box_geom size="0.034 0.150 0.069" xyz="-0.090 0 0" material="accent_blue"/>
      </collision>
    </link>

    <joint name="end_joint" type="fixed">
      <origin xyz="0 0 0.15539" rpy="0 -1.5708 3.1415"/>
      <parent link="link6"/>
      <child link="end_link"/>
      <axis xyz="0 0 0"/>
    </joint>

    <!-- 左指：主动关节，沿 +y 移动 0 → 0.05 m -->
    <link name="finger_left_link">
      <xacro:b601_inertial mass="0.05000000"
        com="0 0 0"
        ixx="0.00001675" ixy="0" ixz="0"
        iyy="0.00003930" iyz="0" izz="0.00004340"/>
      <visual name="finger_left_visual">
        <xacro:b601_box_geom size="0.089 0.050 0.039" xyz="-0.044 0.026 0" material="matte_black"/>
      </visual>
      <collision name="finger_left_collision">
        <xacro:b601_box_geom size="0.089 0.050 0.039" xyz="-0.044 0.026 0" material="matte_black"/>
      </collision>
    </link>

    <joint name="finger_left" type="prismatic">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="end_link"/>
      <child link="finger_left_link"/>
      <axis xyz="0 1 0"/>
      <limit lower="${J['finger_left']['min_pos']}" upper="${J['finger_left']['max_pos']}"
             effort="${J['finger_left']['max_effort']}" velocity="${J['finger_left']['max_velocity']}"/>
    </joint>

    <!-- 右指：从动关节（mimic），位移与左指严格相反 → 平行夹爪 -->
    <link name="finger_right_link">
      <xacro:b601_inertial mass="0.05000000"
        com="0 0 0"
        ixx="0.00001675" ixy="0" ixz="0"
        iyy="0.00003930" iyz="0" izz="0.00004340"/>
      <visual name="finger_right_visual">
        <xacro:b601_box_geom size="0.089 0.050 0.039" xyz="-0.044 -0.026 0" material="matte_black"/>
      </visual>
      <collision name="finger_right_collision">
        <xacro:b601_box_geom size="0.089 0.050 0.039" xyz="-0.044 -0.026 0" material="matte_black"/>
      </collision>
    </link>

    <joint name="finger_right" type="prismatic">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="end_link"/>
      <child link="finger_right_link"/>
      <axis xyz="0 1 0"/>
      <limit lower="${J['finger_right']['min_pos']}" upper="${J['finger_right']['max_pos']}"
             effort="${J['finger_right']['max_effort']}" velocity="${J['finger_right']['max_velocity']}"/>
      <!-- 左指移动 dy，右指移动 -dy；这是“一个驱动器两个手指”的建模方式 -->
      <mimic joint="finger_left" multiplier="-1" offset="0"/>
    </joint>

  </xacro:macro>
</robot>
