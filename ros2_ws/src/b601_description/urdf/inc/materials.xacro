<?xml version="1.0"?>
<!--
  materials.xacro —— 只放颜色/材质，不放几何。

  为什么单独一个文件：后面做 MuJoCo 模型、网页演示（Three.js）时，
  颜色是唯一需要“翻译”的一层，集中在这里最省事。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="seeed_yellow">
    <color rgba="0.73 0.84 0.12 1.0"/>
  </material>

  <material name="matte_black">
    <color rgba="0.07 0.07 0.07 1.0"/>
  </material>

  <material name="dark_grey">
    <color rgba="0.24 0.27 0.27 1.0"/>
  </material>

  <material name="silver">
    <color rgba="0.83 0.84 0.83 1.0"/>
  </material>

  <material name="accent_blue">
    <color rgba="0.10 0.45 0.85 1.0"/>
  </material>

</robot>
