<?xml version="1.0"?>
<!--
  materials.xacro —— 只放颜色/材质，不放几何。

  为什么单独一个文件：后面做 MuJoCo 模型、网页演示（Three.js）时，
  颜色是唯一需要“翻译”的一层，集中在这里最省事。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="b601_materials" params="cfg">
    <material name="seeed_yellow">
      <color rgba="${' '.join(map(str, cfg['model']['materials']['seeed_yellow']))}"/>
    </material>

    <material name="matte_black">
      <color rgba="${' '.join(map(str, cfg['model']['materials']['matte_black']))}"/>
    </material>

    <material name="dark_grey">
      <color rgba="${' '.join(map(str, cfg['model']['materials']['dark_grey']))}"/>
    </material>

    <material name="silver">
      <color rgba="${' '.join(map(str, cfg['model']['materials']['silver']))}"/>
    </material>

    <material name="accent_blue">
      <color rgba="${' '.join(map(str, cfg['model']['materials']['accent_blue']))}"/>
    </material>

  </xacro:macro>
</robot>
