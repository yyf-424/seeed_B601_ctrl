<?xml version="1.0"?>
<!--
  b601_dm.srdf —— MoveIt 的“语义层”。URDF 只描述几何与关节，SRDF 才告诉 MoveIt：
    哪些关节组成一个规划组、常用命名位形有哪些、哪些 link 对永远不可能撞（省算力）。

  三个规划组：
    arm      六轴链 base_link → end_link（MoveIt 的 IK 作用对象）
    gripper  单个 prismatic 关节 finger_left（finger_right 是 mimic，不出现）
-->
<robot name="b601_dm">

  <!-- ================================================================ 规划组 -->
  <group name="arm">
    <chain base_link="base_link" tip_link="end_link"/>
  </group>

  <group name="gripper">
    <joint name="finger_left"/>
  </group>

  <!-- ============================================================ 命名位形 -->
  <!-- 教学用三个位形：全零（竖直奇异位形，只作参考）、略前倾（IK 友好）、
       以及“抬臂外展”——后者适合观察腕部三轴的动作。 -->
  <!-- ⚠ home 不用"全 0"：joint2=joint3=0 是手臂完全竖直的折叠位形，
       本项目用圆柱近似腕部后在该位形下 link1 会与 link3/link5 判为自碰撞，
       MoveIt 会直接拒绝规划。下面的 zero 使用 J2 近零位置作为对照。 -->
  <group_state name="home" group="arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="-0.3"/>
    <joint name="joint3" value="-0.6"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="0.0"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <group_state name="zero" group="arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="-0.001"/>
    <joint name="joint3" value="0.0"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="0.0"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <group_state name="ready" group="arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="-1.0"/>
    <joint name="joint3" value="-1.0"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="0.0"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <group_state name="forward" group="arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="-1.2"/>
    <joint name="joint3" value="-0.8"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="0.6"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <group_state name="open" group="gripper">
    <joint name="finger_left" value="0.045"/>
  </group_state>

  <group_state name="closed" group="gripper">
    <joint name="finger_left" value="0.0"/>
  </group_state>

  <!-- ============================================================ 末端执行器 -->
  <!-- 让 MoveIt 知道“抓取”这个动作属于 gripper 组，父组是 arm（抓放演示要用） -->
  <end_effector name="b601_gripper" parent_link="end_link" group="gripper" parent_group="arm"/>

  <!-- ============================================================ 碰撞豁免 -->
  <!-- reason="Adjacent"：直接相邻的 link 天生互相穿透，必须豁免，否则永远报自碰撞
       reason="Never"   ：几何上不可能相撞的远邻对，豁免后能省掉大量窄相检测 -->
  <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="link6" link2="end_link" reason="Adjacent"/>
  <disable_collisions link1="end_link" link2="finger_left_link" reason="Adjacent"/>
  <disable_collisions link1="end_link" link2="finger_right_link" reason="Adjacent"/>
  <!-- 两个手指在闭合时几何重叠，不能算自碰撞 -->
  <disable_collisions link1="finger_left_link" link2="finger_right_link" reason="Never"/>
  <!-- 腕部与肘部在大角度弯折时的几何干涉（官方 MuJoCo 场景同样排除了这两对） -->
  <disable_collisions link1="link2" link2="link5" reason="Never"/>
  <disable_collisions link1="link3" link2="link5" reason="Never"/>
  <!-- link4 与 link6 在真机上被 link5 隔开、实际不可能相撞；
       本项目的腕部用圆柱近似，两者包围体必然重叠，不豁免就会在起始位形报自碰撞。 -->
  <disable_collisions link1="link4" link2="link6" reason="Never"/>

</robot>
